      <guid>759cc1dc-10f1-46d3-81d4-685204d8d39d</guid>
      <name>Tag Eraser</name>
      <category>Communications and Countermeasures</category>
      <capacity />
      <armorcapacity>[1]</armorcapacity>
      <minrating />
      <maxrating />
      <rating>0</rating>
