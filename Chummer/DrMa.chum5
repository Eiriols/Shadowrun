  <qualities>
    <quality>
      <sourceid>0e741331-d776-4be8-abc5-4101228abdef</sourceid>
      <guid>999bdc42-b8da-43a7-aa16-73620270864a</guid>
      <name>Magician</name>
      <extra />
      <bp>30</bp>
      <implemented>True</implemented>
      <contributetobp>True</contributetobp>
