      <extended>False</extended>
      <customextended>False</customextended>
      <alchemical>False</alchemical>
      <source>SR5</source>
      <page>286</page>
      <extra />
      <notes>The subject detects all living beings (but not spirits) within range of the sense and knows their number and relative location. In a crowded area, the spell is virtually useless, picking up a blurred mass of traces of life.</notes>
      <notesColor>Blue</notesColor>
      <freebonus>False</freebonus>
      <barehandedadept>False</barehandedadept>
      <improvementsource>Spell</improvementsource>
      <grade>0</grade>
    </spell>
